{
  "name": "boardgame",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*/engine",
    "games/*/server",
    "games/*/web",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "node scripts/typecheck.mjs",
    "media": "node scripts/media/record.mjs",
    "local": "node scripts/local.mjs",
    "new-game": "node scripts/new-game.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
