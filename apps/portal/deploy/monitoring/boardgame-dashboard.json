      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (players) (increase(bg_matches_started_total{game=~\"$game\"}[7d]))",
          "legendFormat": "{{players}}명",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
