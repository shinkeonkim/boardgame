          },
          "expr": "topk(10, sum by (emote) (increase(bg_emotes_total{game=~\"$game\"}[7d])))",
          "legendFormat": "{{emote}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
