          "legendFormat": "{{kind}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason) (increase(bg_join_failures_total{game=~\"$game\"}[1h]))",
          "legendFormat": "실패 · {{reason}}",
          "refId": "B"
