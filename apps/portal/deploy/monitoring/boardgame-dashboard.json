    {
      "type": "bargauge",
      "title": "지금 방 인원",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (players) (bg_rooms_by_players{game=~\"$game\"})",
